{
  "name": "keyconf-launch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.29 preview",
    "check": "hyperframes check --at 1,3,9,15,21,27,33 --timeout 30000",
    "render": "node scripts/render.mjs",
    "publish": "npx --yes hyperframes@0.8.29 publish",
    "snapshot": "hyperframes snapshot --at 1,3,9,15,21,27,33 --output snapshots/review --describe false",
    "master:audio": "python scripts/master-audio.py"
  },
  "devDependencies": {
    "gsap": "3.13.0",
    "hyperframes": "0.8.29",
    "playwright": "1.62.1",
    "three": "0.185.1"
  }
}
