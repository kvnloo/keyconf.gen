diff --git c/frontend/src/ts/keyconf-embed.ts w/frontend/src/ts/keyconf-embed.ts
new file mode 100644
index 0000000..dbd761c
--- /dev/null
+++ w/frontend/src/ts/keyconf-embed.ts
@@ -0,0 +1,35 @@
+// Keyconf guest integration. Original typing and result engines remain upstream.
+const parentOrigin = window.location.origin;
+const held = new Set<string>();
+const send = (event: string, detail = {}) => {
+  if (window.parent !== window) window.parent.postMessage({ type: 'keyconf:monkeytype', event, ...detail }, parentOrigin);
+};
+window.addEventListener('keydown', event => {
+  if (!(event.target instanceof HTMLElement) || event.target.id !== 'wordsInput' || event.repeat || event.ctrlKey || event.metaKey || event.altKey) return;
+  if (!/^(Key[A-Z]|Digit[0-9]|Space|Backspace|Enter|ShiftLeft|ShiftRight|Comma|Period|Slash|Semicolon|Quote|BracketLeft|BracketRight|Backslash|Minus|Equal|Backquote)$/.test(event.code)) return;
+  held.add(event.code);
+  send('key', { code: event.code, down: true });
+}, true);
+window.addEventListener('keyup', event => {
+  if (held.delete(event.code)) send('key', { code: event.code, down: false });
+}, true);
+window.addEventListener('blur', () => { held.clear(); send('clear'); });
+window.addEventListener('pagehide', () => { held.clear(); send('clear'); });
+let ready = false;
+let lastHeight = 0;
+const report = () => {
+  const app = document.getElementById('app');
+  if (!app || app.classList.contains('hidden')) return;
+  if (!ready && document.querySelector('#words .word')) {
+    ready = true;
+    document.getElementById('wordsInput')?.setAttribute('aria-label', 'Typing test input');
+    send('ready');
+  }
+  const height = Math.ceil(app.getBoundingClientRect().bottom + 24);
+  if (height !== lastHeight) { lastHeight = height; send('height', { height }); }
+};
+window.addEventListener('DOMContentLoaded', () => {
+  new MutationObserver(report).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
+  new ResizeObserver(report).observe(document.getElementById('app') ?? document.body);
+  report();
+});
