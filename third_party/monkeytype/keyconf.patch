diff --git c/frontend/src/keyconf-embed.css w/frontend/src/keyconf-embed.css
new file mode 100644
index 0000000..d202a71
--- /dev/null
+++ w/frontend/src/keyconf-embed.css
@@ -0,0 +1,23 @@
+/* Keyconf guest widget. Monkeytype's test controls, input and result UI are retained. */
+html, body { min-height: 0 !important; height: auto !important; }
+body { padding: 20px 24px !important; overflow-x: hidden; }
+#app { min-height: 0 !important; padding: 0 !important; gap: 20px !important; grid-template-rows: [top-start] 0 [content-start] auto [content-end] 0 [top-end] !important; }
+#app > main { min-height: 0 !important; height: auto !important; }
+header, footer, .ad, #keymap, #banner, #banners, .merchBanner { display: none !important; }
+[data-ui-element="testConfig"] { margin: 0 0 20px; opacity: 1 !important; flex-wrap: wrap; }
+[data-ui-element="testConfig"] button { min-height: 32px; }
+#typingTest { padding: 0 !important; }
+#restartTestButton { margin-top: 12px; margin-bottom: 0; min-height: 40px; }
+#result .stats { gap: 12px; }
+.content-grid { --content-max-width: 1100px; --padding-inline: 0px; }
+@media (max-width: 600px) {
+ body { padding: 16px 12px !important; }
+ #words { font-size: 1.2rem !important; }
+ [data-ui-element="testConfig"] button { min-height: 40px; }
+}
+@media (prefers-reduced-motion: reduce) {
+ *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
+}
+
+#app { row-gap: 0 !important; }
+#app, #app > main { display: block !important; height: auto !important; overflow: visible !important; }
