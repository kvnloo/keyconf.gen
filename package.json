{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check app lib db scripts tests videos/keyconf-launch/scripts drizzle.config.ts next.config.ts vite.config.ts vite.pages.config.ts tsconfig.json .oxlintrc.json .github/workflows/publish.yml package.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:pages": "vite build --config vite.pages.config.ts",
    "verify:browser": "node scripts/verify_browser.mjs",
    "verify:imports": "node scripts/verify_imports.mjs",
    "verify:import-pages": "node scripts/verify_import_pagination.mjs",
    "verify:interface": "node scripts/verify_interface.mjs",
    "verify:decks": "node scripts/verify_decks.mjs",
    "verify:typing": "node scripts/verify_typing.mjs",
    "verify:featured": "node --experimental-strip-types scripts/verify_featured.mjs",
    "verify:observations": "node scripts/verify_observations.mjs",
    "verify:room": "node scripts/verify_room.mjs",
    "catalog:observe": "node --experimental-strip-types scripts/observe_catalog.mjs",
    "db:generate": "drizzle-kit generate",
    "catalog:publish": "node --experimental-strip-types scripts/publish_catalog.mjs",
    "verify:catalog": "node scripts/verify_catalog.mjs",
    "verify:accessories": "node --experimental-strip-types scripts/verify_accessories.mjs",
    "verify:switches": "node scripts/verify_switches.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "three": "^0.185.1",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260903.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
